# ========================================================
# SMARTENVELOPE - MẪU BIẾN MÔI TRƯỜNG DÀNH CHO CÁC THÀNH VIÊN
# ========================================================
# Hướng dẫn:
# 1. Tạo file `.env` tại thư mục gốc dự án (nếu chạy với công cụ hỗ trợ đọc .env).
# 2. Hoặc thiết lập các biến môi trường trực tiếp trên hệ điều hành / IDE (Run Configurations).
# 3. Hoặc truyền qua dòng lệnh Maven: -DDB_USERNAME=root -DDB_PASSWORD=your_password

# Cấu hình Cổng máy chủ ứng dụng (mặc định: 8080)
PORT=8080

# Cấu hình Kết nối MySQL
DB_URL=jdbc:mysql://localhost:3306/smart_envelope?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Cấu hình Hibernate DDL (update: cập nhật bảng, không xóa dữ liệu)
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
