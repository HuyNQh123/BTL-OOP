# ========================================================
# SMARTENVELOPE - MẪU BIẾN MÔI TRƯỜNG DÀNH CHO CÁC THÀNH VIÊN
# ========================================================
# Hướng dẫn:
# 1. Tạo bản sao file này thành `.env` tại thư mục gốc dự án.
# 2. Điền mật khẩu MySQL cá nhân của bạn vào biến DB_PASSWORD bên dưới.
# 3. File `.env` đã được cấu hình trong .gitignore, sẽ KHÔNG bị đẩy lên GitHub.

# Cổng máy chủ ứng dụng (mặc định: 8080)
PORT=8080

# Cấu hình Kết nối MySQL cá nhân
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_envelope
DB_USERNAME=root
DB_PASSWORD=your_password_here

# Cấu hình Hibernate DDL & SQL Log
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=true

# Gemini API (tạo key tại https://aistudio.google.com/app/apikey)
# Sao chép file này thành .env rồi thay giá trị khóa bằng key của bạn.
AI_API_KEY=your_gemini_api_key_here
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
AI_MODEL=gemini-3.8-flash

# SMTP để gửi email thông báo và lời mời (ví dụ Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=your_email@gmail.com
SMTP_AUTH=true
SMTP_STARTTLS=true
APP_BASE_URL=http://localhost:8080
